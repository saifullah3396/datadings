#!python
"""Shuffle an existing dataset file.
"""
import sys
import os.path as pt

from datadings.reader import IdentityReader
from datadings.reader import Shuffler
from datadings.writer import RawWriter


def shuffle(infile, outfile):
    r = IdentityReader(infile)
    shuffler = Shuffler(r)
    with RawWriter(outfile) as writer:
        for key, raw in shuffler.rawiter(yield_key=True):
            writer.write(key, raw)


def main():
    import argparse
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        'infile',
        help='file to shuffle',
    )
    parser.add_argument(
        'outfile',
        help='output file; cannot be same as infile',
    )
    args, unknown = parser.parse_known_args()
    infile = pt.abspath(args.infile)
    outfile = pt.abspath(args.outfile)
    if infile == outfile:
        parser.print_usage()
        print('Input and output file must be different.')
        sys.exit(1)
    shuffle(infile, outfile)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    finally:
        print()
