#!/usr/bin/env python

import sys
import os.path as pt

from datadings.reader import IdentityReader
from datadings.reader import Shuffler
from datadings.writer import Writer


class RawWriter(Writer):
    def write(self, key, data):
        self._indices[key] = self._outfile.tell()
        self._write_data(data)


def shuffle(infile, outfile):
    r = IdentityReader(infile)
    shuffler = Shuffler(r)
    with RawWriter(outfile) as writer:
        for key, raw in shuffler.rawiter(yield_key=True):
            writer.write(key, raw)


def main():
    import argparse
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        'infile',
    )
    parser.add_argument(
        'outfile',
    )
    args, unknown = parser.parse_known_args()
    infile = pt.abspath(args.infile)
    outfile = pt.abspath(args.outfile)
    if infile == outfile:
        parser.print_usage()
        print('Input and output file must be different.')
        sys.exit(1)
    shuffle(infile, outfile)


if __name__ == '__main__':
    main()
