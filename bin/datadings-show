#!/usr/bin/env python
from __future__ import print_function

import io
import pylab as plt
import warnings
from six import text_type
from PIL import Image

from datadings.sets import SaliencyReader


def show_saliency(path, delay):
    warnings.filterwarnings("ignore", ".*GUI is implemented.*")
    reader = SaliencyReader(path)
    fig, ax = plt.subplots()
    im = None
    for sample in reader:
        ax.clear()
        image = Image.open(io.BytesIO(sample.image))
        if im is None:
            ax.imshow(image)
        else:
            im.set_data(image)
        for experiment in sample.groundtruth:
            for point in experiment.locations:
                ax.add_artist(plt.Circle(point, 3, color='red'))
        plt.draw()
        plt.pause(delay)
    plt.close(fig)


def main():
    import argparse
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        'datatype',
        choices=('saliency',),
        help='type of dataset'
    )
    parser.add_argument(
        'path',
        type=text_type,
        help='type of dataset'
    )
    parser.add_argument(
        '-d', '--delay',
        type=float,
        default=1,
        help='delay between images'
    )
    args = parser.parse_args()
    try:
        if args.datatype == 'saliency':
            show_saliency(args.path, args.delay)
    except KeyboardInterrupt:
        print()


if __name__ == '__main__':
    main()
