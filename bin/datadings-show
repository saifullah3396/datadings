#!/usr/bin/env python
from __future__ import print_function

import io
import pylab as plt
from six import text_type
from PIL import Image

from datadings.sets import SaliencyReader


def show_saliency(path, delay):
    reader = SaliencyReader(path)
    for sample in reader:
        fig, ax = plt.subplots()
        image = Image.open(io.BytesIO(sample.image))
        ax.imshow(image)
        for experiment in sample.groundtruth:
            for point in experiment.locations:
                ax.add_artist(plt.Circle(point, 3, color='red'))
        plt.show()
        plt.close(fig)


def main():
    import argparse
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        'datatype',
        choices=('saliency',),
        help='type of dataset'
    )
    parser.add_argument(
        'path',
        type=text_type,
        help='type of dataset'
    )
    parser.add_argument(
        '-d', '--delay',
        type=int,
        default=2000,
        help='delay between images'
    )
    args = parser.parse_args()
    try:
        if args.datatype == 'saliency':
            show_saliency(args.path, args.delay)
    except KeyboardInterrupt:
        print()


if __name__ == '__main__':
    main()
