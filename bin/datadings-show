#!/usr/bin/env python
"""Display the contents of a dataset file.

Requires OpenCV.
"""
from __future__ import print_function

from six import text_type

import numpy as np
try:
    import cv2
except ImportError:
    print('OpenCV is required to display images.')
    import sys
    sys.exit(1)

from datadings.reader import MsgpackReader


def _decode(data):
    tmp = np.frombuffer(data, dtype=np.uint8)
    return cv2.imdecode(tmp, cv2.IMREAD_COLOR)


def show_saliency(path, delay):
    delay = int(delay*1000)
    reader = MsgpackReader(path)
    for sample in reader:
        im = _decode(sample['image'])
        for x, y in sample['experiments'][0]['locations']:
            cv2.circle(im, (int(x), int(y)), 3, (0, 0, 255), -1)
        cv2.imshow('Press Q to exit', im)
        if cv2.waitKey(delay) == ord('q'):
            break


def main():
    import argparse
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        'datatype',
        choices=('saliency',),
        help='type of dataset',
    )
    parser.add_argument(
        'path',
        type=text_type,
        help='path to dataset file',
    )
    parser.add_argument(
        '-d', '--delay',
        type=float,
        default=1,
        help='delay between images',
    )
    args = parser.parse_args()
    if args.datatype == 'saliency':
        show_saliency(args.path, args.delay)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    finally:
        print()
