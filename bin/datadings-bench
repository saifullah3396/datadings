#!python
"""Run a read benchmark on a given dataset file.
"""
from __future__ import print_function

import time
import os.path as pt

from datadings.reader import MsgpackReader
from datadings.tools import make_printer


def bench(infile, raw):
    r = MsgpackReader(infile)
    printer = make_printer(desc='bench ' + pt.basename(infile), total=len(r))
    a = time.time()
    if raw:
        for _ in r.rawiter():
            printer()
    else:
        for _ in r:
            printer()
    d = time.time() - a
    n = printer.n
    s = n / d
    b = pt.getsize(infile) / d / 1024 / 1024
    printer.close()
    print('%s samples read in %.2f seconds, %.2f samples/s, %.2f MB/s'
          % (n, d, s, b), end='')


def main():
    import argparse
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        'infile',
        help='file to benchmark'
    )
    parser.add_argument(
        '-r', '--raw',
        help='do not deserialize samples',
        action='store_true'
    )
    args, unknown = parser.parse_known_args()
    bench(args.infile, args.raw)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    finally:
        print()
