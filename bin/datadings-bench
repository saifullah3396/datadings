#!python
"""Run a read benchmark on a given dataset file.
"""
from __future__ import print_function

import time
import os.path as pt

from datadings.reader import IdentityReader
from datadings.tools import make_printer


def bench(infile):
    r = IdentityReader(infile)
    printer = make_printer(desc='bench ' + pt.basename(infile))
    a = time.time()
    for _ in r:
        printer()
    d = time.time() - a
    n = printer.n
    s = n / d
    printer.close()
    print('%s samples read in %.2f seconds, %.2f samples/s'
          % (n, d, s), end='')


def main():
    import argparse
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        'infile',
        help='file to benchmark',
    )
    args, unknown = parser.parse_known_args()
    bench(args.infile)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    finally:
        print()
